# ── WitnessChain Backend — Environment Variables ──
# Copy this file to  .env  and fill in the values.
# Never commit the real .env to git.

# Inference server URL. Use http://localhost:8000 with mock_infer_server.py,
# or the ngrok URL printed by the Colab notebook (it changes on every Colab restart).
COLAB_INFER_URL=http://localhost:8000

# Supabase (supabase.com → Project Settings → API). Optional for local dev:
# if these are empty, community-alert logging is skipped.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# OpenAI — optional. If set, GPT-3.5 is used for report generation.
# If not set, a rule-based generator is used.
# OPENAI_API_KEY=your-openai-key
